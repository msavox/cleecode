/target
octave-workspace
.venv/
# vhs insists on a GIF alongside the screenshots; only the .png files are kept.
docs/.shots-scratch.gif

# Virtualenvs for the examples folder: they make the venv picker demo work locally,
# but they are 24 MB of machine-specific paths and belong to nobody else's checkout.
examples/.venv*

# Python's own leavings from the harnesses in scripts/.
__pycache__/

# What the IDE-mode probes leave behind when run: workspace snapshots, rendered figures
# and the temp file the atomic write goes through. They are run from the directory holding
# the library files (scripts/ide/README.md), so the litter lands in assets/.
assets/octave/*.json
assets/octave/*.png
assets/python/*.json
assets/python/*.png
assets/python/pyfigs/
assets/**/*.tmp
assets/python/pyenv/

# The Python and Octave hooks write here when CLEECODE_DBG_LOG is set, which is the one way
# to find out why a tick failed silently. One of these was committed by accident once.
dbg*.log
